<Application x:Class="SSHTunnel4Win.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SSHTunnel4Win.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <conv:ConnectionStateToColorConverter x:Key="StateToColor"/>
        <conv:ConnectionStateToLabelConverter x:Key="StateToLabel"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:InverseBoolConverter x:Key="InvBool"/>
        <conv:AuthMethodToBoolConverter x:Key="AuthMethodToBool"/>
        <conv:TunnelTypeToVisibilityConverter x:Key="TypeToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVis"/>
        <conv:CountToVisibilityConverter x:Key="CountToVis"/>

        <!-- Icon-only buttons (Segoe MDL2 glyph as content) -->
        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Small square button used to remove a row (forwarding rule, directive) -->
        <Style x:Key="RowDeleteButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        </Style>

        <!-- Grey hint text overlaid on an empty TextBox -->
        <Style x:Key="PlaceholderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Padding" Value="12,3"/>
        </Style>
    </Application.Resources>
</Application>

<UserControl x:Class="SSHTunnel4Win.Views.TunnelListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:SSHTunnel4Win.Resources">
    <Grid>
        <ListBox x:Name="TunnelListBox" SelectionChanged="OnSelectionChanged" KeyDown="OnListKeyDown"
                 HorizontalContentAlignment="Stretch" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="{x:Static res:Strings.Tunnels}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,5" Background="Transparent" ToolTip="{Binding StateLabel}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Ellipse Grid.Column="0" Grid.RowSpan="2" Width="10" Height="10"
                                 Fill="{Binding State, Converter={StaticResource StateToColor}}"
                                 Margin="0,0,8,0" VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding DisplayName}"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Subtitle}" FontSize="11" Opacity="0.7"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- Number of forwarding rules -->
                        <Border Grid.Column="2" Grid.RowSpan="2" CornerRadius="8" Margin="6,0,0,0"
                                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1"
                                Padding="6,0" VerticalAlignment="Center"
                                Visibility="{Binding HasTunnels, Converter={StaticResource BoolToVis}}"
                                ToolTip="{x:Static res:Strings.PortForwarding}">
                            <TextBlock Text="{Binding TunnelCount}" FontSize="11"
                                       Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                        </Border>

                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding ConnectLabel}" Click="ToggleConnect" FontWeight="SemiBold"
                                          IsEnabled="{Binding CanToggle}"/>
                                <MenuItem Header="{x:Static res:Strings.Reconnect}" Click="ReconnectTunnel"
                                          Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                                <Separator/>
                                <MenuItem Header="{x:Static res:Strings.CopyShareString}" Click="CopyShareString"/>
                                <Separator/>
                                <MenuItem Header="{x:Static res:Strings.Delete}" Click="DeleteTunnel" InputGestureText="Del"/>
                            </ContextMenu>
                        </Grid.ContextMenu>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty state -->
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed" Margin="16">
            <TextBlock Text="{x:Static res:Strings.NoTunnels}" FontSize="16"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="{x:Static res:Strings.AddTunnelHint}"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       HorizontalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center" MaxWidth="220"/>
            <Button x:Name="ImportPuttyButton" Content="{x:Static res:Strings.ImportFromPuTTYButton}"
                    HorizontalAlignment="Center" Margin="0,14,0,0" Padding="12,4"
                    Click="ImportPuttyClick" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>

<Window x:Class="SSHTunnel4Win.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SSHTunnel4Win.Views"
        xmlns:res="clr-namespace:SSHTunnel4Win.Resources"
        Title="{x:Static res:Strings.SSHTunnelManager}"
        Width="820" Height="600" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.AddCommand}" Executed="AddClick"/>
        <CommandBinding Command="{x:Static local:MainWindow.ImportCommand}" Executed="ImportClick"/>
        <CommandBinding Command="{x:Static local:MainWindow.PasteImportCommand}" Executed="PasteImport"/>
        <CommandBinding Command="{x:Static local:MainWindow.SettingsCommand}" Executed="SettingsClick"/>
        <CommandBinding Command="{x:Static local:MainWindow.QuitCommand}" Executed="QuitClick"/>
        <CommandBinding Command="{x:Static local:MainWindow.HelpCommand}" Executed="HelpClick"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Command="{x:Static local:MainWindow.AddCommand}" Key="N" Modifiers="Control"/>
        <KeyBinding Command="{x:Static local:MainWindow.ImportCommand}" Key="I" Modifiers="Control"/>
        <!-- TextBoxes handle Ctrl+V themselves first, so this only fires when focus is elsewhere -->
        <KeyBinding Command="{x:Static local:MainWindow.PasteImportCommand}" Key="V" Modifiers="Control"/>
        <KeyBinding Command="{x:Static local:MainWindow.SettingsCommand}" Key="OemComma" Modifiers="Control"/>
        <KeyBinding Command="{x:Static local:MainWindow.QuitCommand}" Key="Q" Modifiers="Control"/>
        <KeyBinding Command="{x:Static local:MainWindow.HelpCommand}" Key="F1"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{x:Static res:Strings.File}">
                <MenuItem x:Name="AddMenuItem" Header="{x:Static res:Strings.AddTunnel}"
                          Command="{x:Static local:MainWindow.AddCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="{x:Static res:Strings.ImportFromShareString}"
                          Command="{x:Static local:MainWindow.ImportCommand}" InputGestureText="Ctrl+I"/>
                <MenuItem Header="{x:Static res:Strings.ImportFromPuTTY}" Click="ImportPuttyClick"/>
                <Separator/>
                <MenuItem Header="{x:Static res:Strings.Settings}"
                          Command="{x:Static local:MainWindow.SettingsCommand}" InputGestureText="Ctrl+,"/>
                <Separator/>
                <MenuItem Header="{x:Static res:Strings.Quit}"
                          Command="{x:Static local:MainWindow.QuitCommand}" InputGestureText="Ctrl+Q"/>
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.Tunnels}">
                <MenuItem Header="{x:Static res:Strings.ReconnectAll}" Click="ReconnectAllClick"/>
                <MenuItem Header="{x:Static res:Strings.DisconnectAll}" Click="DisconnectAllClick"/>
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.Help}">
                <MenuItem Header="{x:Static res:Strings.Help}"
                          Command="{x:Static local:MainWindow.HelpCommand}" InputGestureText="F1"/>
                <MenuItem Header="{x:Static res:Strings.RunningSSHProcesses}" Click="ProcessListClick"/>
                <Separator/>
                <MenuItem Header="{x:Static res:Strings.CheckForUpdates}" Click="CheckForUpdatesClick"/>
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <DockPanel Grid.Column="0">
                <!-- Tab selector -->
                <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="8,8,8,4">
                    <RadioButton x:Name="TunnelTabBtn" Content="{x:Static res:Strings.Tunnels}"
                                 IsChecked="True" GroupName="SidebarTab" Padding="6,4"
                                 Style="{StaticResource {x:Type ToggleButton}}"
                                 Click="TunnelTabClick"/>
                    <RadioButton x:Name="SSHConfigTabBtn" Content="{x:Static res:Strings.SSHConfig}"
                                 GroupName="SidebarTab" Padding="6,4"
                                 Style="{StaticResource {x:Type ToggleButton}}"
                                 Click="SSHConfigTabClick"/>
                </UniformGrid>

                <!-- Toolbar -->
                <Border DockPanel.Dock="Top" Padding="6,2"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                <Setter Property="Padding" Value="6,4"/>
                            </Style>
                            <Style TargetType="Separator" BasedOn="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>
                        </StackPanel.Resources>
                        <Button x:Name="AddBtn" Command="{x:Static local:MainWindow.AddCommand}"
                                ToolTip="{x:Static res:Strings.AddTunnel}"
                                AutomationProperties.Name="{x:Static res:Strings.AddTunnel}">
                            <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}"/>
                        </Button>
                        <Button Command="{x:Static local:MainWindow.ImportCommand}"
                                ToolTip="{x:Static res:Strings.ImportFromShareString}"
                                AutomationProperties.Name="{x:Static res:Strings.ImportFromShareString}">
                            <TextBlock Text="&#xE896;" Style="{StaticResource IconGlyph}"/>
                        </Button>
                        <Separator/>
                        <Button Click="ProcessListClick" ToolTip="{x:Static res:Strings.RunningSSHProcesses}"
                                AutomationProperties.Name="{x:Static res:Strings.RunningSSHProcesses}">
                            <TextBlock Text="&#xE756;" Style="{StaticResource IconGlyph}"/>
                        </Button>
                        <Button Command="{x:Static local:MainWindow.HelpCommand}" ToolTip="{x:Static res:Strings.Help}"
                                AutomationProperties.Name="{x:Static res:Strings.Help}">
                            <TextBlock Text="&#xE897;" Style="{StaticResource IconGlyph}"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Content: use Grid so both lists can fill -->
                <Grid>
                    <local:TunnelListView x:Name="TunnelList"/>
                    <local:SSHConfigListView x:Name="SSHConfigList" Visibility="Collapsed"/>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                          Focusable="False"/>

            <!-- Detail pane -->
            <ContentControl Grid.Column="2" x:Name="DetailPane" Focusable="False"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
    </DockPanel>
</Window>

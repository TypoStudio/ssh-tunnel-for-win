<Window x:Class="SSHTunnel4Win.Views.ForwardingImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:SSHTunnel4Win.Resources"
        Title="{x:Static res:Strings.AddPortForwardingFromCLI}"
        Width="460" Height="320" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static res:Strings.Cancel}" Width="80" Click="CancelClick" Margin="0,0,8,0"/>
            <Button x:Name="AddBtn" Content="{x:Static res:Strings.Add}" Width="80" Click="AddClick" IsEnabled="False"/>
        </StackPanel>

        <!-- Hint -->
        <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.PasteForwardingOptionsHint}"
                   TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"/>

        <!-- Preview -->
        <GroupBox DockPanel.Dock="Bottom" Header="{x:Static res:Strings.Preview}" Margin="0,8,0,0"
                  x:Name="PreviewBox" Visibility="Collapsed">
            <ItemsControl x:Name="PreviewList" Margin="8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="Gray"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>

        <!-- Input -->
        <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                 TextChanged="InputChanged"/>
    </DockPanel>
</Window>

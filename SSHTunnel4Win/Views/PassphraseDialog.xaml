<Window x:Class="SSHTunnel4Win.Views.PassphraseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:SSHTunnel4Win.Resources"
        Title="{x:Static res:Strings.PassphraseTitle}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <DockPanel Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="&#xE192;" Style="{StaticResource IconGlyph}" FontSize="28"
                       VerticalAlignment="Top" Margin="0,2,12,0"/>
            <StackPanel>
                <TextBlock x:Name="KeyNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="KeyPathText" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                <TextBlock x:Name="UsedByText" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            </StackPanel>
        </DockPanel>

        <TextBlock Text="{x:Static res:Strings.PassphrasePrompt}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <PasswordBox x:Name="PassphraseBox" PasswordChanged="PassphraseChanged" Padding="2,3"
                     AutomationProperties.Name="{x:Static res:Strings.PassphraseTitle}"/>
        <TextBlock x:Name="ErrorText" Text="{x:Static res:Strings.KeyErrorWrongPassphrase}" Foreground="#C42B1C"
                   Margin="0,6,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkBtn" Content="{x:Static res:Strings.OK}" Style="{StaticResource DialogButton}"
                    IsDefault="True" IsEnabled="False" Click="OkClick" Margin="0,0,8,0"/>
            <Button Content="{x:Static res:Strings.Skip}" Style="{StaticResource DialogButton}" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>

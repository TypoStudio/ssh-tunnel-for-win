<UserControl x:Class="SSHTunnel4Win.Views.TunnelDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:SSHTunnel4Win.Resources"
             xmlns:local="clr-namespace:SSHTunnel4Win.Views"
             xmlns:models="clr-namespace:SSHTunnel4Win.Models">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
        </Style>
        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header: status on the left, actions on the right -->
        <Border DockPanel.Dock="Top" Padding="12,6"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Click="LoadFromSSHConfig" Style="{StaticResource HeaderIconButton}"
                            ToolTip="{x:Static res:Strings.LoadFromSSHConfig}"
                            AutomationProperties.Name="{x:Static res:Strings.LoadFromSSHConfig}">
                        <TextBlock Text="&#xE8E5;" Style="{StaticResource IconGlyph}"/>
                    </Button>
                    <Button Click="ShowLog" Style="{StaticResource HeaderIconButton}"
                            ToolTip="{x:Static res:Strings.ConnectionLog}"
                            AutomationProperties.Name="{x:Static res:Strings.ConnectionLog}">
                        <TextBlock Text="&#xE8A5;" Style="{StaticResource IconGlyph}"/>
                    </Button>
                    <Button Command="{Binding ReconnectCommand}" Style="{StaticResource HeaderIconButton}"
                            ToolTip="{x:Static res:Strings.Reconnect}"
                            AutomationProperties.Name="{x:Static res:Strings.Reconnect}"
                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyph}"/>
                    </Button>
                    <Button x:Name="ConnectButton" Command="{Binding ToggleConnectCommand}" MinWidth="110" Padding="10,4"
                            Margin="4,0,0,0" FontWeight="SemiBold"
                            ToolTip="{Binding ConnectDisabledReason}" ToolTipService.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ConnectGlyph" Style="{StaticResource IconGlyph}" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ConnectLabel" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Status is spelled out, not only color-coded -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Static res:Strings.Status}">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                             Fill="{Binding State, Converter={StaticResource StateToColor}}"/>
                    <TextBlock Text="{Binding State, Converter={StaticResource StateToLabel}}"
                               VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Error banner: selectable so the ssh output can be copied -->
        <Border x:Name="ErrorBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="#FDE7E9" BorderBrush="#F1BBBC" BorderThickness="0,0,0,1" Padding="12,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xEA39;" Style="{StaticResource IconGlyph}"
                           Foreground="#C42B1C" VerticalAlignment="Top" Margin="0,2,8,0"/>
                <TextBox x:Name="ErrorText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                         Background="Transparent" Foreground="#A4262C" FontSize="11"
                         MaxHeight="90" VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>

        <!-- Form -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="16,12,16,16">
                <!-- Connection -->
                <GroupBox Header="{x:Static res:Strings.Connection}" Margin="0,0,0,12">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.Name}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                                 AutomationProperties.Name="{x:Static res:Strings.Name}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.Host}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                                 AutomationProperties.Name="{x:Static res:Strings.Host}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:Strings.Port}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="80" HorizontalAlignment="Left" Margin="0,0,0,6" MaxLength="5"
                                 local:NumericInput.IsEnabled="True"
                                 AutomationProperties.Name="{x:Static res:Strings.Port}"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static res:Strings.Username}" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{x:Static res:Strings.Username}"/>
                    </Grid>
                </GroupBox>

                <!-- Authentication -->
                <GroupBox Header="{x:Static res:Strings.Authentication}" Margin="0,0,0,12">
                    <StackPanel Margin="8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton Content="{x:Static res:Strings.IdentityFile}" GroupName="Auth"
                                         IsChecked="{Binding AuthMethod, Converter={StaticResource AuthMethodToBool}, ConverterParameter=IdentityFile}"
                                         Margin="0,0,16,0"/>
                            <RadioButton Content="{x:Static res:Strings.Password}" GroupName="Auth"
                                         IsChecked="{Binding AuthMethod, Converter={StaticResource AuthMethodToBool}, ConverterParameter=Password}"/>
                        </StackPanel>
                        <!-- Identity File -->
                        <DockPanel x:Name="IdentityFilePanel">
                            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.BrowseBtn}"
                                    Command="{Binding BrowseIdentityFileCommand}" Margin="8,0,0,0" Padding="10,1"/>
                            <TextBox Text="{Binding IdentityFile, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{x:Static res:Strings.IdentityFile}"/>
                        </DockPanel>
                        <!-- Password, or the key's passphrase in identity-file mode (same secure storage) -->
                        <TextBlock x:Name="PassphraseLabel" Text="{x:Static res:Strings.KeyPassphrase}" Margin="0,8,0,4"/>
                        <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordChanged"
                                     AutomationProperties.Name="{x:Static res:Strings.Password}"/>
                    </StackPanel>
                </GroupBox>

                <!-- Port Forwarding -->
                <GroupBox Header="{x:Static res:Strings.PortForwarding}" Margin="0,0,0,12">
                    <StackPanel Margin="8">
                        <!-- Column headers: neutral wording, because for -R the "listen" side is the server -->
                        <Grid Margin="0,0,0,4" x:Name="EntryHeader"
                              Visibility="{Binding TunnelEntries.Count, Converter={StaticResource CountToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="108"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Type}" Style="{StaticResource ColumnHeader}"/>
                            <TextBlock Grid.Column="1" Text="{x:Static res:Strings.ListenPort}" Style="{StaticResource ColumnHeader}"
                                       ToolTip="{x:Static res:Strings.ListenPortTip}"/>
                            <TextBlock Grid.Column="2" Text="{x:Static res:Strings.DestinationHost}" Style="{StaticResource ColumnHeader}"
                                       ToolTip="{x:Static res:Strings.DestinationTip}"/>
                            <TextBlock Grid.Column="3" Text="{x:Static res:Strings.DestinationPort}" Style="{StaticResource ColumnHeader}"
                                       ToolTip="{x:Static res:Strings.DestinationTip}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding TunnelEntries}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="108"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" SelectedValue="{Binding Type}" Margin="0,0,4,0"
                                                  SelectedValuePath="Tag" AutomationProperties.Name="{x:Static res:Strings.Type}">
                                            <ComboBoxItem Content="{x:Static res:Strings.TunnelTypeLocal}" Tag="{x:Static models:TunnelType.Local}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.TunnelTypeRemote}" Tag="{x:Static models:TunnelType.Remote}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.TunnelTypeDynamic}" Tag="{x:Static models:TunnelType.Dynamic}"/>
                                        </ComboBox>
                                        <TextBox Grid.Column="1" Text="{Binding LocalPortText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"
                                                 MaxLength="5" local:NumericInput.IsEnabled="True" VerticalContentAlignment="Center"
                                                 ToolTip="{x:Static res:Strings.ListenPortTip}"
                                                 AutomationProperties.Name="{x:Static res:Strings.ListenPort}"/>
                                        <TextBox Grid.Column="2" Text="{Binding RemoteHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"
                                                 VerticalContentAlignment="Center"
                                                 AutomationProperties.Name="{x:Static res:Strings.DestinationHost}"
                                                 Visibility="{Binding Type, Converter={StaticResource TypeToVis}}"/>
                                        <TextBox Grid.Column="3" Text="{Binding RemotePortText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"
                                                 MaxLength="5" local:NumericInput.IsEnabled="True" VerticalContentAlignment="Center"
                                                 AutomationProperties.Name="{x:Static res:Strings.DestinationPort}"
                                                 Visibility="{Binding Type, Converter={StaticResource TypeToVis}}"/>
                                        <Button Grid.Column="4" Command="{Binding DeleteCommand}" Style="{StaticResource RowDeleteButton}"
                                                ToolTip="{x:Static res:Strings.DeleteRule}"
                                                AutomationProperties.Name="{x:Static res:Strings.DeleteRule}">
                                            <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}" FontSize="10"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,4,0,0">
                            <Button Command="{Binding AddTunnelEntryCommand}" Margin="0,0,8,0" Padding="8,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}" FontSize="11" Margin="0,0,6,0"/>
                                    <TextBlock Text="{x:Static res:Strings.AddRule}"/>
                                </StackPanel>
                            </Button>
                            <Button Content="{x:Static res:Strings.AddFromCLI}" Command="{Binding AddFromCLICommand}" Padding="8,2"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Options -->
                <GroupBox Header="{x:Static res:Strings.Options}" Margin="0,0,0,12">
                    <StackPanel Margin="8">
                        <CheckBox Content="{x:Static res:Strings.AutoConnectOnLaunch}" IsChecked="{Binding AutoConnect}" Margin="0,0,0,6"/>
                        <CheckBox Content="{x:Static res:Strings.DisconnectOnQuit}" IsChecked="{Binding DisconnectOnQuit}" Margin="0,0,0,6"/>
                        <CheckBox Content="{x:Static res:Strings.AutoReconnectOnDisconnect}" IsChecked="{Binding AutoReconnect}" Margin="0,0,0,10"/>
                        <TextBlock Text="{x:Static res:Strings.AdditionalSSHArguments}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding AdditionalArgs, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"
                                 AutomationProperties.Name="{x:Static res:Strings.AdditionalSSHArguments}"/>
                    </StackPanel>
                </GroupBox>

                <!-- Share -->
                <GroupBox Header="{x:Static res:Strings.Share}">
                    <WrapPanel Orientation="Horizontal" Margin="8">
                        <Button Content="{x:Static res:Strings.CopyShareString}" Command="{Binding CopyShareStringCommand}"
                                Margin="0,0,8,4" Padding="8,2"/>
                        <Button Content="{x:Static res:Strings.CopyCLICommand}" Command="{Binding CopyCLICommandCommand}"
                                Margin="0,0,8,4" Padding="8,2"/>
                        <TextBlock Text="{Binding CopyFeedback}" VerticalAlignment="Center" Margin="0,0,0,4"
                                   Visibility="{Binding ShowCopied, Converter={StaticResource BoolToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#107C10"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CopyFailed}" Value="True">
                                            <Setter Property="Foreground" Value="#C42B1C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </WrapPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

<UserControl x:Class="SSHTunnel4Win.Views.SSHConfigDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:SSHTunnel4Win.Resources"
             xmlns:local="clr-namespace:SSHTunnel4Win.Views">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,6"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="Control">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="12,6"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding ToggleTextEditCommand}" Padding="8,4" Margin="0,0,4,0"
                        IsEnabled="{Binding IsTextEditMode, Converter={StaticResource InvBool}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;" Style="{StaticResource IconGlyph}" FontSize="12" Margin="0,0,6,0"/>
                        <TextBlock Text="{x:Static res:Strings.EditAsText}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenInEditorCommand}" Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" Style="{StaticResource IconGlyph}" FontSize="12" Margin="0,0,6,0"/>
                        <TextBlock Text="{x:Static res:Strings.OpenInEditor}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Content: text edit and form share same space -->
        <Grid>
            <!-- Text edit mode -->
            <DockPanel Visibility="{Binding IsTextEditMode, Converter={StaticResource BoolToVis}}" Margin="16">
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{x:Static res:Strings.Apply}" Command="{Binding ToggleTextEditCommand}"
                                Style="{StaticResource DialogButton}" Margin="0,0,8,0"/>
                        <Button Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelTextEditCommand}"
                                Style="{StaticResource DialogButton}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TextEditError}" Foreground="#C42B1C" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                </DockPanel>
                <TextBox Text="{Binding TextEditContent, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         AutomationProperties.Name="{x:Static res:Strings.EditAsText}"/>
            </DockPanel>

            <!-- Form mode -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                          Visibility="{Binding IsTextEditMode, Converter={StaticResource InvBoolToVis}}">
                <!-- Shared size scope keeps every label column the same width across groups -->
                <StackPanel Margin="16,12,16,16" Grid.IsSharedSizeScope="True">
                    <GroupBox Header="{x:Static res:Strings.SSHConfig}" Margin="0,0,0,12">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.Host}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                                     AutomationProperties.Name="{x:Static res:Strings.Host}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.File}" Style="{StaticResource FieldLabel}" Margin="0,0,12,0"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableFiles}"
                                      SelectedItem="{Binding SourceFile}" AutomationProperties.Name="{x:Static res:Strings.File}"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="{x:Static res:Strings.Connection}" Margin="0,0,0,12">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.HostName}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HostName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                                     AutomationProperties.Name="{x:Static res:Strings.HostName}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.User}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                                     AutomationProperties.Name="{x:Static res:Strings.User}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:Strings.Port}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                                     Width="80" HorizontalAlignment="Left" MaxLength="5" local:NumericInput.IsEnabled="True"
                                     AutomationProperties.Name="{x:Static res:Strings.Port}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static res:Strings.IdentityFile}" Style="{StaticResource FieldLabel}" Margin="0,0,12,0"/>
                            <DockPanel Grid.Row="3" Grid.Column="1">
                                <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.BrowseBtn}"
                                        Command="{Binding BrowseIdentityFileCommand}" Margin="8,0,0,0" Padding="10,1"/>
                                <TextBox Text="{Binding IdentityFile, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{x:Static res:Strings.IdentityFile}"/>
                            </DockPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="{x:Static res:Strings.Proxy}" Margin="0,0,0,12">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.ProxyCommand}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ProxyCommand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                                     AutomationProperties.Name="{x:Static res:Strings.ProxyCommand}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.ProxyJump}" Style="{StaticResource FieldLabel}" Margin="0,0,12,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ProxyJump, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{x:Static res:Strings.ProxyJump}"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="{x:Static res:Strings.Options}" Margin="0,0,0,12">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.ForwardAgent}" Style="{StaticResource FieldLabel}"/>
                            <!-- yes/no are the common values; editable so other valid values aren't lost -->
                            <ComboBox Grid.Row="0" Grid.Column="1" IsEditable="True" Width="100" HorizontalAlignment="Left" Margin="0,0,0,6"
                                      Text="{Binding ForwardAgent, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="{x:Static res:Strings.ForwardAgent}">
                                <ComboBoxItem Content="yes"/>
                                <ComboBoxItem Content="no"/>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.ServerAliveInterval}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ServerAliveInterval, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                                     Width="80" HorizontalAlignment="Left" local:NumericInput.IsEnabled="True"
                                     AutomationProperties.Name="{x:Static res:Strings.ServerAliveInterval}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:Strings.ServerAliveCountMax}" Style="{StaticResource FieldLabel}" Margin="0,0,12,0"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ServerAliveCountMax, UpdateSourceTrigger=PropertyChanged}"
                                     Width="80" HorizontalAlignment="Left" local:NumericInput.IsEnabled="True"
                                     AutomationProperties.Name="{x:Static res:Strings.ServerAliveCountMax}"/>
                        </Grid>
                    </GroupBox>

                    <!-- Other Directives -->
                    <GroupBox Header="{x:Static res:Strings.OtherDirectives}">
                        <StackPanel Margin="8">
                            <Grid Margin="0,0,0,4" Visibility="{Binding OtherDirectives.Count, Converter={StaticResource CountToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Key}" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Value}" FontWeight="SemiBold" FontSize="11"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding OtherDirectives}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"
                                                     MinWidth="140" AutomationProperties.Name="{x:Static res:Strings.Key}"/>
                                            <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"
                                                     AutomationProperties.Name="{x:Static res:Strings.Value}"/>
                                            <Button Grid.Column="2" Command="{Binding DeleteCommand}" Style="{StaticResource RowDeleteButton}"
                                                    ToolTip="{x:Static res:Strings.DeleteDirective}"
                                                    AutomationProperties.Name="{x:Static res:Strings.DeleteDirective}">
                                                <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}" FontSize="10"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Command="{Binding AddDirectiveCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="8,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}" FontSize="11" Margin="0,0,6,0"/>
                                    <TextBlock Text="{x:Static res:Strings.AddDirective}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
